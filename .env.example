# Bu dosya yalnızca hangi değişkenlerin gerektiğini gösterir; gerçek değer içermez.
# Kopyalayıp .env.local adıyla kaydet ve değerleri doldur (.env.local git'e girmez).
#
# Yerel değerler: `npm run db:start` çıktısındaki "API URL" ve "anon key".
# dev / prod değerleri: Supabase panelinde Project Settings → API.

# Uygulama (Expo) — EXPO_PUBLIC_ ile başlayanlar uygulamanın içine gömülür; gizli anahtar koyma.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase CLI ile uzak projelere bağlanmak için (supabase link / db push / functions deploy)
SUPABASE_ACCESS_TOKEN=
SUPABASE_DEV_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=
